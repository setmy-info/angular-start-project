{
    "name": "angular-start-project-brand-style",
    "version": "1.0.0-SNAPSHOT",
    "description": "Brand-page styles (separate design system from the webapp styles)",
    "license": "MIT",
    "author": "Imre Tabur",
    "main": "index.less",
    "scripts": {
        "format": "prettier --write .",
        "lint": "stylelint \"**/*.less\"",
        "lint:fix": "stylelint \"**/*.less\" --fix",
        "build": "node ../../scripts/build.js",
        "build:brand-example": "lessc brand-example/brand.less brand-example/dist/brand.css",
        "server": "node ../../scripts/http-server.js",
        "stop-server": "node ../../scripts/http-server.js stop",
        "watch": "node ../../scripts/watch-less.js"
    },
    "devDependencies": {
        "less": "^4.5.1"
    },
    "dependencies": {
        "setmy-info-less": "^5.1.1"
    },
    "config": {
        "moduleType": "less-package",
        "cssExpectation": "content",
        "server": {
            "port": 4500,
            "directory": "dist"
        }
    },
    "files": [
        "index.less",
        "src",
        "README.md"
    ]
}
