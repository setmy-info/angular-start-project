{
    "name": "angular-start-project",
    "version": "1.0.0-SNAPSHOT",
    "description": "Angular Application",
    "license": "SEE LICENSE IN ../../LICENSE.md",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "node ../../scripts/build.js",
        "ng": "ng",
        "ver": "node bin/versionModule.js",
        "start": "ng serve",
        "watch": "ng build --watch --configuration local",
        "test:watch": "ng test --watch",
        "e2e:one": "jest --config=jest.e2e.config.js --testNamePattern",
        "server": "node ../../scripts/http-server.js",
        "stop-server": "node ../../scripts/http-server.js stop"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.7.0",
    "dependencies": {
        "@angular/common": "^22.1.3",
        "@angular/compiler": "^22.1.3",
        "@angular/core": "^22.1.3",
        "@angular/forms": "^22.1.3",
        "@angular/platform-browser": "^22.1.3",
        "@angular/router": "^22.1.3",
        "@angular/service-worker": "^22.1.3",
        "@tsparticles/engine": "^3.0.0",
        "@tsparticles/slim": "^3.0.0",
        "angular-start-project-library": "^1.0.0-SNAPSHOT",
        "angular-start-project-style": "^1.0.0-SNAPSHOT",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.1.5",
        "@angular/cli": "^22.1.5",
        "@angular/compiler-cli": "^22.1.3",
        "jest": "^30.4.2",
        "jsdom": "^28.0.0",
        "less": "^4.2.0",
        "selenium-webdriver": "^4.46.0",
        "typescript": "~6.0.3",
        "vitest": "^4.0.8"
    },
    "config": {
        "moduleType": "angular-app",
        "server": {
            "port": 4210,
            "directory": "dist/application/browser",
            "spa": true
        }
    }
}
