{
  "name": "angular-start-project",
  "version": "1.0.0-SNAPSHOT",
  "description": "Angular Application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "wdio run wdio.conf.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@tsparticles/engine": "^3.0.0",
    "@tsparticles/slim": "^3.0.0",
    "angular-start-project-library": "^1.0.0-SNAPSHOT",
    "angular-start-project-style": "^1.0.0-SNAPSHOT",
    "rxjs": "~7.8.0",
    "setmy-info-less": "^3.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "less": "^4.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
