{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app",
            "installMode": "prefetch",
            "resources": {
                "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/icons/**",
                    "/images/**",
                    "/fonts/**",
                    "/css/**",
                    "/js/**",
                    "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
                ]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "translations",
            "urls": ["/json/en.json", "/json/et.json", "/json/translations-version.json"],
            "cacheConfig": {
                "strategy": "freshness",
                "maxSize": 10,
                "maxAge": "1d",
                "timeout": "3s"
            }
        },
        {
            "name": "content",
            "urls": ["/json/content/**"],
            "cacheConfig": {
                "strategy": "freshness",
                "maxSize": 50,
                "maxAge": "1d",
                "timeout": "3s"
            }
        },
        {
            "name": "api",
            "urls": ["/api/**", "/rest/**"],
            "cacheConfig": {
                "strategy": "freshness",
                "maxSize": 100,
                "maxAge": "1h",
                "timeout": "5s"
            }
        }
    ],
    "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/rest/**"]
}
