{
    "name": "angular-start-project-root",
    "private": true,
    "workspaces": [
        "packages/angular-start-project-style",
        "packages/angular-start-project-brand-style",
        "packages/angular-start-project-brandpage",
        "packages/angular-start-project-library",
        "packages/angular-start-project"
    ],
    "version": "1.0.0-SNAPSHOT",
    "description": "Angular start project monorepo - thin Angular layer over framework-independent JS",
    "license": "SEE LICENSE IN LICENSE.md",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "node scripts/format.js",
        "format:check": "node scripts/format.js --check",
        "lint": "eslint . && stylelint \"packages/angular-start-project-style/**/*.less\" \"packages/angular-start-project-brand-style/**/*.less\" \"packages/angular-start-project-brandpage/**/*.less\" \"packages/angular-start-project/src/**/*.less\"",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "generate-sources": "node scripts/generate-sources.js",
        "resources": "node scripts/resources.js",
        "build": "npm run build --workspaces --if-present",
        "verify": "node scripts/verify.js",
        "pre-integration-test": "node scripts/lifecycle.js pre-integration-test",
        "post-integration-test": "node scripts/lifecycle.js post-integration-test",
        "pre-e2e-test": "node scripts/lifecycle.js pre-e2e-test",
        "post-e2e-test": "node scripts/lifecycle.js post-e2e-test",
        "test": "node scripts/test.js unit",
        "integration-test": "node scripts/test.js integration",
        "e2e-test": "node scripts/test.js e2e",
        "coverage": "node scripts/test.js coverage",
        "audit": "npm audit --audit-level=high",
        "reports": "node scripts/reports.js",
        "docs": "node scripts/docs.js",
        "package": "node scripts/package.js",
        "bundle": "node scripts/bundle.js",
        "deploy": "node scripts/deploy.js",
        "release": "node scripts/release.js",
        "server": "node scripts/http-server.js",
        "stop-server": "node scripts/http-server.js stop"
    },
    "config": {
        "bundle": {
            "archiveName": "angular-start-project",
            "outputDir": "build",
            "brands": [
                "angular-start-project-brandpage"
            ],
            "apps": [
                "angular-start-project"
            ]
        }
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.7.0",
        "globals": "^16.4.0",
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "jsdoc": "^4.0.5",
        "jsdom": "^27.4.0",
        "less": "^4.5.1",
        "less-plugin-clean-css": "^1.6.0",
        "postcss-less": "^6.0.0",
        "prettier": "^3.9.5",
        "selenium-webdriver": "^4.46.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "typescript-eslint": "^8.64.0"
    }
}
